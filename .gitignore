# Backup snapshot file per-versi (mis. "Helpers v1.5.2.php") — disimpan
# di disk dev untuk referensi, tidak boleh ke-commit ke history.
* v*.*.*.php
* v*.*.*.blade.php

# Claude Code local settings (personal, jangan di-commit)
.claude/

# Seed lokal berisi kredensial/token (mis. API Token Accurate) — RAHASIA,
# jangan pernah ke-commit. DDL-nya ada di database/sql/*.sql (aman).
/database/sql/local/

# Docs internal/sensitif & binary — disimpan lokal, jangan ke-commit ke GitHub.
