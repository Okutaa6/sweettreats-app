# Backup snapshot file per-versi (mis. "Helpers v1.5.2.php") — disimpan
# di disk dev untuk referensi, tidak boleh ke-commit ke history.
* v*.*.*.php
* v*.*.*.blade.php

# Claude Code local settings (personal, jangan di-commit)
.claude/

# Seed lokal berisi kredensial/token (mis. API Token Accurate) — RAHASIA,
# jangan pernah ke-commit. DDL-nya ada di database/sql/*.sql (aman).
/database/sql/local/

# Docs internal/sensitif & binary — disimpan lokal, jangan ke-commit ke GitHub.
# PDF bikin repo bengkak; proposal vendor & panduan onboarding bersifat internal.
docs/**/*.pdf
docs/api/proposal-sweet-treats-api-omnicare-v2.md
docs/untuk-reza/git-workflow-reza.html

# Foto upload dokter — aset yang di-upload user, jangan di-track di git.
/public/uploads/doctors/

# Foto bukti checklist mingguan — di-upload karyawan saat runtime, bukan aset repo.
/public/uploads/checklist-photos/

# Lampiran Pengajuan/ROP: penawaran, bukti transfer, nota pertanggungjawaban.
# Dokumen keuangan milik cabang — tidak ada gunanya di repo, dan sekali masuk
# git ia ikut ke setiap klon selamanya.
/public/uploads/rop/

# Design brief internal yang tercecer di ROOT repo (hasil unduhan handoff
# desain) — dokumen kerja, bukan bagian app. SENGAJA dibatasi ke root:
# brief yang dirawat di docs/brief-desain/ HARUS tetap ikut git (lihat
# docs/README.md — folder itu bagian dari dokumentasi proyek).
/design-brief-*.md
